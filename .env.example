# ─────────────────────────────────────────────────────────────────────────────
# Agri Doctor — Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai (Extension Officer Agent — IBM Granite 4 H Small) ────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-0-tiny-preview

# ── Google Gemini Vision (Pathologist Agent — Primary) ──────────────────────
# Free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# ── Groq (Pathologist Agent — Fallback, if vision model available) ──────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=qwen/qwen3.8-27b

# ── WhatsApp Business Cloud API (Meta Graph API) — for actual message sending ─
# Get from: https://developers.facebook.com/apps → WhatsApp → Getting Started
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# ── Twilio WhatsApp API (Alternative sending method) ────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# ── Default WhatsApp phone number (saved from Settings page) ────────────────
# DEFAULT_WA_PHONE=+919876543210

# ── Optional: Database path (default: agri_doctor.db in project root) ───────
# DATABASE_PATH=agri_doctor.db
